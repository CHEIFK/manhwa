{
  "name": "Manwa Manager",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [
    8765
  ],
  "portsAttributes": {
    "8765": {
      "label": "Manwa Manager",
      "protocol": "http",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "pip install -r requirements.txt",
  "postStartCommand": "nohup python3 app.py > /tmp/manwa-manager.log 2>&1 &"
}
